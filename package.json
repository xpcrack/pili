{
  "name": "web3-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "scripts": {
    "local:live": "PATH=\"$HOME/.bun/bin:$PATH\" bun --hot server/runtime.ts live",
    "local:prod": "PATH=\"$HOME/.bun/bin:$PATH\" bun server/runtime.ts prod",
    "build:next": "next build",
    "start:next": "next start --port 3005",
    "dev": "PATH=\"$HOME/.bun/bin:$PATH\" bun --hot server/runtime.ts live",
    "dev:proxy": "HTTP_PROXY=http://127.0.0.1:7897 HTTPS_PROXY=http://127.0.0.1:7897 NODE_OPTIONS='--require ./scripts/proxy-bootstrap.cjs' next dev --port 3005",
    "build": "PATH=\"$HOME/.bun/bin:$PATH\" bun run build:client",
    "build:client": "vite build",
    "start": "PATH=\"$HOME/.bun/bin:$PATH\" bun server/runtime.ts prod",
    "lint": "eslint",
    "telegram:bridge": "NODE_OPTIONS='--require ./scripts/server-only-shim.cjs' tsx scripts/telegram-bridge.ts",
    "telegram:bridge:backfill": "NODE_OPTIONS='--require ./scripts/server-only-shim.cjs' tsx scripts/telegram-bridge-backfill.ts",
    "telegram:bridge:install-launchagent": "./scripts/install-telegram-bridge-launchagent.sh",
    "telegram:channel:login": "NODE_OPTIONS='--require ./scripts/server-only-shim.cjs' tsx scripts/telegram-channel-login.ts",
    "telegram:channel:sync": "NODE_OPTIONS='--require ./scripts/server-only-shim.cjs' tsx scripts/telegram-channel-sync.ts",
    "telegram:channel:worker": "NODE_OPTIONS='--require ./scripts/server-only-shim.cjs' tsx scripts/telegram-channel-worker.ts",
    "telegram:channel:install-launchagent": "./scripts/install-telegram-channel-sync-launchagent.sh",
    "completeness:worker": "NODE_OPTIONS='--require ./scripts/server-only-shim.cjs' tsx scripts/completeness-maintenance-worker.ts",
    "telegram:agent:approval-bot": "NODE_OPTIONS='--require ./scripts/server-only-shim.cjs' tsx scripts/telegram-agent-approval-bot.ts",
    "telegram:agent:read": "NODE_OPTIONS='--require ./scripts/server-only-shim.cjs' tsx scripts/telegram-agent-read.ts",
    "audit:historical-asset-peaks": "NODE_OPTIONS='--require ./scripts/server-only-shim.cjs' tsx scripts/audit-historical-asset-peaks.ts",
    "importance:backfill": "NODE_OPTIONS='--require ./scripts/server-only-shim.cjs' tsx scripts/backfill-importance-score.ts",
    "test": "tsx scripts/lib/runTests.ts",
    "check": "npx tsc --noEmit && npm test -- --filter=runtime-task-registry && npm test -- --filter=runtime-env-fallback && npm test -- --filter=runtime-data-fallback && npm test -- --filter=telegram-bridge-runtime && PATH=\"$HOME/.bun/bin:$PATH\" bun scripts/test-bun-route-compat.ts && PATH=\"$HOME/.bun/bin:$PATH\" bun run build",
    "runtime:status": "tsx scripts/runtime-mode.ts status",
    "runtime:dev:on": "tsx scripts/runtime-mode.ts dev-on",
    "runtime:dev:off": "tsx scripts/runtime-mode.ts dev-off",
    "runtime:refresh": "tsx scripts/runtime-mode.ts refresh",
    "agent:install": "PATH=\"$HOME/.bun/bin:$PATH\" bun server/launchagent.ts install",
    "agent:restart": "PATH=\"$HOME/.bun/bin:$PATH\" bun server/launchagent.ts restart",
    "test:runtime-mode": "tsx scripts/test-runtime-mode.ts",
    "test:runtime-docs": "tsx scripts/test-runtime-docs.ts",
    "holdings:refresh": "NODE_OPTIONS='--require ./scripts/server-only-shim.cjs' tsx scripts/refresh-holdings.ts",
    "holdings:refresh:dry": "NODE_OPTIONS='--require ./scripts/server-only-shim.cjs' tsx scripts/refresh-holdings.ts --dry",
    "holdings:stats": "NODE_OPTIONS='--require ./scripts/server-only-shim.cjs' tsx scripts/refresh-holdings.ts --stats"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@hono/node-server": "^2.0.4",
    "@vitejs/plugin-react": "^6.0.2",
    "better-sqlite3": "11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "hono": "^4.12.23",
    "lucide-react": "^1.8.0",
    "next": "^16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "file:./stubs/server-only",
    "shadcn": "^4.2.0",
    "tailwind-merge": "^3.5.0",
    "telegram": "^2.26.22",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.0.14",
    "wouter": "^3.10.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "global-agent": "^4.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
