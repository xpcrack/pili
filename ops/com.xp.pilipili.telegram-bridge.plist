<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.xp.pilipili.telegram-bridge</string>
    <key>WorkingDirectory</key>
    <string>/Users/xp/vibecoding/pilipili</string>
    <key>ProgramArguments</key>
    <array>
      <string>/Users/xp/vibecoding/pilipili/node_modules/.bin/tsx</string>
      <string>scripts/telegram-bridge.ts</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/pilipili-telegram-bridge.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/pilipili-telegram-bridge.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
  </dict>
</plist>
